{"kind":"table","sheet":"Terminal value","address":"A1:E33","rows":33,"cols":5,"values":[[null,null,null,null,null],["Lec07 | Terminal value",null,null,"Complete the blank cells in column B.",null],["Activity 2 | 2 points",null,null,"Formula suggestions are text, not calculations.",null],[null,null,null,null,null],["Your name",null,null,"Your section",null],["Case ID",null,null,null,null],[null,null,null,null,null],["1. Copy your individual case inputs",null,null,"Source: your Lec07 Activity 2 case card.",null],["D1 | Year 1 dividend",null,null,"Dollars per share",null],["D2 | Year 2 dividend",null,null,"Dollars per share",null],["D3 | Year 3 dividend",null,null,"Dollars per share",null],["k | Required return",null,null,"Type the percentage, including the % sign.",null],["gS | Stable growth rate",null,null,"Check that k is greater than gS.",null],[null,null,null,null,null],["2. Build your valuation",null,null,null,null],["Calculation (dollars per share)","Your formula / result",null,"Suggested Excel formula","What it does"],["D4 | First stable dividend",null,null,"=B11*(1+B13)","Grow the year 3 dividend once."],["TV3 | Value at end of year 3",null,null,"=B17/(B12-B13)","Value dividends from year 4 onward."],["PV of D1",null,null,"=B9/(1+$B$12)","Discount the year 1 dividend."],["PV of D2",null,null,"=B10/(1+$B$12)^2","Discount the year 2 dividend."],["PV of D3",null,null,"=B11/(1+$B$12)^3","Discount the year 3 dividend."],["PV of terminal value",null,null,"=B18/(1+$B$12)^3","Bring TV3 back to today."],["P0 | Value today",null,null,"=SUM(B19:B22)","Add the four present values."],[null,null,null,null,null],["3. Submit in the lecture",null,null,null,null],["TV3: use your result in B18.",null,null,"P0: use your result in B23.",null],[null,null,null,null,null],["Enter both answers in Activity 2 and click Submit.",null,null,null,null],["Use two decimals when submitting; keep full precision in Excel.",null,null,null,null],["TV3 is at year 3. P0 is at year 0. Do not confuse TV3 with its present value.",null,null,null,null],[null,null,null,null,null],["To use a suggestion: type the displayed formula in the matching blank B cell.",null,null,null,null],["Complete every input and calculation. This workbook does not submit your work.",null,null,null,null]]}
