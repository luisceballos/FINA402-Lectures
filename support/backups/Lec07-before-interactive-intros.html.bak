  <input type="password" id="new-pin" placeholder="New PIN" autocomplete="new-password" style="flex:1;padding:6px;border-radius:6px;border:1px solid var(--border);background:var(--bg);color:var(--text);font-size:.8rem">
  <button class="btn btn-gold" id="save-pin" style="padding:6px 10px;font-size:.78rem">Update</button>
 </div>
