 <div style="display:flex;gap:8px;align-items:center;margin-bottom:6px">
  <input type="text" id="new-code" placeholder="New code (e.g. FINA402)" autocomplete="new-password" maxlength="128" style="flex:1;padding:6px;border-radius:6px;border:1px solid var(--border);background:var(--bg);color:var(--text);font-size:.8rem;text-transform:uppercase">
  <button class="btn btn-gold" id="save-code" style="padding:6px 10px;font-size:.78rem">Update</button>
 </div>
 <div style="font-size:.7rem;color:var(--muted)">Current: <span id="current-code" style="font-family:monospace;color:var(--gold)">—</span></div>

