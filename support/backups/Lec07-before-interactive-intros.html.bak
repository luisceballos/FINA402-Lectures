<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="referrer" content="strict-origin-when-cross-origin"><title>Lec07 · Discounted Cash Flows</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap">
<style>
:root{
  --accent:#6B1A2B;--gold:#B8962E;--gold-lt:#FAF3DC;
  --bg:#F7F4F0;--surface:#FFFFFF;--border:#E2DDD8;
  --text:#1A1614;--muted:#6B6461;
  --radius:10px;--shadow:0 2px 12px rgba(0,0,0,.08);
  --green:#1A7A4A;--red:#C0392B;
}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#151210;--surface:#1F1B18;--border:#2E2926;
  --text:#EDE8E3;--muted:#9A948F;--gold-lt:#2A2210;
}}
:root[data-theme="dark"]{--bg:#151210;--surface:#1F1B18;--border:#2E2926;--text:#EDE8E3;--muted:#9A948F;--gold-lt:#2A2210;}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);height:100vh;overflow:hidden;display:flex;flex-direction:column}

/* TOP BAR */
#topbar{display:flex;align-items:center;gap:12px;padding:0 20px;height:50px;background:var(--surface);border-bottom:1px solid var(--border);flex-shrink:0}
#topbar .course{font-family:'DM Serif Display',serif;font-size:.95rem;color:var(--accent)}
#topbar .sep{color:var(--border)}
#topbar #slide-ctr{font-size:.78rem;font-family:'JetBrains Mono',monospace;color:var(--muted)}
#topbar .spacer{flex:1}
#topbar #user-bar{font-size:.75rem;color:var(--muted);display:flex;align-items:center;gap:8px}
#topbar #user-bar strong{color:var(--gold)}
#topbar .btn-sm{padding:4px 10px;border-radius:5px;border:1.5px solid var(--border);background:transparent;color:var(--text);font-size:.72rem;cursor:pointer;font-family:'Inter',sans-serif}
#topbar .btn-sm:hover{border-color:var(--gold);color:var(--gold)}
#theme-btn{padding:5px 8px;border-radius:5px;border:1.5px solid var(--border);background:transparent;color:var(--muted);cursor:pointer;font-size:.8rem}

/* DECK */
#deck{flex:1;position:relative;overflow:hidden}
.slide{position:absolute;inset:0;display:none;flex-direction:column;padding:28px 48px 16px;overflow-y:auto;background:var(--bg)}
.slide.active{display:flex}
.slide-header{margin-bottom:18px;flex-shrink:0}
.eyebrow{font-size:.65rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);margin-bottom:5px}
.slide-header h2{font-family:'DM Serif Display',serif;font-size:2rem;line-height:1.15;color:var(--text)}
.slide-body{flex:1;display:flex;gap:28px;min-height:0}
.col-l{flex:1.1;min-width:0;display:flex;flex-direction:column;gap:14px}
.col-r{flex:.9;min-width:0;display:flex;flex-direction:column;gap:14px}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px 18px;box-shadow:var(--shadow)}

/* BOTTOM NAV */
#bottom-nav{display:flex;align-items:center;justify-content:center;gap:16px;height:44px;background:var(--surface);border-top:1px solid var(--border);flex-shrink:0}
.nav-btn{width:36px;height:36px;border-radius:50%;border:1.5px solid var(--border);background:transparent;color:var(--text);cursor:pointer;font-size:1.1rem;display:flex;align-items:center;justify-content:center;transition:.15s}
.nav-btn:hover{border-color:var(--gold);color:var(--gold)}
#progress-dots{display:flex;gap:5px}
.pdot{width:6px;height:6px;border-radius:50%;background:var(--border);cursor:pointer;transition:.15s}
.pdot.on{background:var(--gold)}

/* TITLE SLIDE */
#s0{background:var(--accent);padding:60px}
#s0 .kicker{font-size:.72rem;letter-spacing:.15em;text-transform:uppercase;color:rgba(255,255,255,.5);margin-bottom:10px}
#s0 h1{font-family:'DM Serif Display',serif;font-size:3rem;color:#fff;line-height:1.1;max-width:620px}
#s0 .subtitle{font-size:1rem;color:rgba(255,255,255,.65);margin-top:14px;max-width:500px}
#s0 .meta{margin-top:36px;font-size:.75rem;color:rgba(255,255,255,.35)}

/* AGENDA */
.agenda-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:4px}
.ag-item{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:10px 12px;display:flex;align-items:flex-start;gap:10px}
.ag-num{width:22px;height:22px;border-radius:50%;background:var(--gold);color:#fff;font-size:.68rem;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}
.ag-item h4{font-size:.82rem;font-weight:600;margin-bottom:2px}
.ag-item p{font-size:.72rem;color:var(--muted)}

/* MATH */
.math-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px 18px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:14px}
.math-block{display:flex;flex-direction:column;gap:5px}
.math-label{font-size:.65rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.math-line{font-family:'JetBrains Mono',monospace;font-size:.82rem;line-height:1.8;color:var(--text);padding:2px 0}
.math-line.result{font-weight:700;color:var(--gold);font-size:.9rem;border-top:1px solid var(--border);padding-top:6px;margin-top:2px}
.rho-red{color:var(--red);font-weight:700}
.note-box{background:var(--gold-lt);border-radius:7px;padding:10px 12px;font-size:.8rem;border:1px solid rgba(184,150,46,.3)}

/* CANVAS */
canvas{border-radius:8px;border:1px solid var(--border);background:var(--surface)}
.canvas-wrap{position:relative;display:flex;align-items:center;justify-content:center}
.canvas-wrap canvas{max-width:100%;height:auto}

/* FORMS */
label{font-size:.75rem;font-weight:600;color:var(--muted);display:block;margin-bottom:4px}
input[type=number],input[type=text],select{width:100%;padding:7px 10px;border:1.5px solid var(--border);border-radius:6px;background:var(--surface);color:var(--text);font-size:.85rem;font-family:'Inter',sans-serif}
input:focus,select:focus{outline:none;border-color:var(--gold)}
.btn{padding:8px 18px;border-radius:7px;border:none;cursor:pointer;font-size:.82rem;font-weight:600;font-family:'Inter',sans-serif;transition:.15s}
.btn-accent{background:var(--accent);color:#fff}
.btn-gold{background:var(--gold);color:#fff}
.btn-ghost{background:transparent;border:1.5px solid var(--border);color:var(--text)}
.btn:hover{filter:brightness(1.08)}
.btn:disabled{opacity:.4;cursor:not-allowed}
.msg-ok{color:var(--green);font-weight:600;font-size:.82rem;margin-top:6px}
.msg-err{color:var(--red);font-weight:600;font-size:.82rem;margin-top:6px}

/* STAT TILES */
.stat-row{display:flex;gap:10px}
.stat-tile{flex:1;text-align:center;background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:10px 6px}
.stat-tile .val{font-family:'JetBrains Mono',monospace;font-size:1.3rem;font-weight:600;color:var(--gold)}
.stat-tile .lbl{font-size:.65rem;color:var(--muted);margin-top:3px}

/* WEIGHTS TABLE */
.w-table{width:100%;border-collapse:collapse;font-size:.76rem}
.w-table th{background:var(--accent);color:#fff;padding:5px 7px;text-align:left;font-size:.7rem}
.w-table td{padding:4px 7px;border-bottom:1px solid var(--border)}
.w-table tr:nth-child(even) td{background:var(--gold-lt)}
.w-bar{height:7px;border-radius:4px;background:var(--gold);display:inline-block;vertical-align:middle;margin-right:4px}

/* SUBMISSION LOG */
.sub-log{max-height:100px;overflow-y:auto;font-size:.71rem;display:flex;flex-direction:column;gap:3px;margin-top:6px}
.sub-entry{padding:3px 8px;border-radius:4px;background:var(--gold-lt);color:var(--gold);font-family:'JetBrains Mono',monospace}
.sub-entry.err{background:#FEE;color:var(--red)}

/* SHARPE */
.sharpe-formula{font-size:1.2rem;text-align:center;padding:14px;font-family:'JetBrains Mono',monospace;background:var(--gold-lt);border-radius:8px;border:1px solid rgba(184,150,46,.3)}

/* MODAL / GATE */
#gate{position:fixed;inset:0;background:rgba(15,12,10,.75);z-index:200;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px)}
#gate-box{background:var(--surface);border-radius:16px;padding:32px;width:360px;box-shadow:0 24px 70px rgba(0,0,0,.35)}
#gate-box .logo{font-family:'DM Serif Display',serif;font-size:1.4rem;color:var(--accent);margin-bottom:4px}
#gate-box .sub{font-size:.8rem;color:var(--muted);margin-bottom:20px}
.pill-tabs{display:flex;gap:5px;background:var(--bg);border-radius:8px;padding:4px;margin-bottom:16px}
.pill-tab{flex:1;padding:7px;text-align:center;border-radius:6px;cursor:pointer;font-size:.8rem;font-weight:600;color:var(--muted);transition:.15s}
.pill-tab.on{background:var(--surface);color:var(--text);box-shadow:0 1px 5px rgba(0,0,0,.12)}
.gate-field{margin-bottom:12px}
.gate-field label{font-size:.75rem;font-weight:600;color:var(--muted);display:block;margin-bottom:4px}
#gate-err{color:var(--red);font-size:.78rem;margin-top:8px;display:none}
#gate-code-note{font-size:.72rem;color:var(--muted);margin-bottom:14px;background:var(--gold-lt);border-radius:6px;padding:7px 10px}

/* OPTIMIZATION MATH */
.opt-section{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px 18px}
.opt-section h3{font-family:'DM Serif Display',serif;font-size:1.1rem;color:var(--accent);margin-bottom:10px}
.opt-line{font-family:'JetBrains Mono',monospace;font-size:.8rem;line-height:1.9;color:var(--text)}
.opt-line.hl{color:var(--gold);font-weight:600}
.opt-line.comment{color:var(--muted);font-size:.72rem}

/* TANGENCY */
.cal-legend{display:flex;flex-direction:column;gap:6px;margin-top:8px}
.cal-entry{display:flex;align-items:center;gap:8px;font-size:.78rem;padding:5px 8px;border-radius:6px;transition:.3s}
.cal-entry .dot{width:12px;height:12px;border-radius:50%;flex-shrink:0}
.cal-entry.winner{background:var(--gold-lt);font-weight:600;color:var(--gold)}

/* SHARPE BAR CHART */
.sr-bars{display:flex;flex-direction:column;gap:6px;margin-top:8px}
.sr-bar-row{display:flex;align-items:center;gap:8px;font-size:.75rem}
.sr-bar-row .name{width:120px;text-overflow:ellipsis;overflow:hidden;white-space:nowrap;color:var(--muted);font-size:.7rem}
.sr-bar-bg{flex:1;height:18px;background:var(--bg);border-radius:9px;overflow:hidden;border:1px solid var(--border)}
.sr-bar-fill{height:100%;border-radius:9px;background:var(--gold);transition:width .5s}
.sr-bar-fill.accent{background:var(--accent)}
.sr-val{width:45px;text-align:right;font-family:'JetBrains Mono',monospace;font-size:.72rem;color:var(--muted)}

/* DOWNLOAD LINK */
.dl-link{display:inline-flex;align-items:center;gap:7px;padding:7px 14px;border-radius:7px;border:1.5px solid var(--gold);color:var(--gold);font-size:.78rem;font-weight:600;text-decoration:none;transition:.15s}
.dl-link:hover{background:var(--gold-lt)}

/* WHAT WE LEARNED */
.wl-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:4px}
.wl-item{background:var(--surface);border:1px solid var(--border);border-left:4px solid var(--gold);border-radius:8px;padding:10px 14px;font-size:.82rem;line-height:1.5}

/* PART 2 WEIGHTS INPUT */
.weights-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.wg-item{display:flex;flex-direction:column;gap:2px}
.wg-item label{font-size:.65rem;font-weight:700;color:var(--accent)}
.wg-item input{padding:5px 7px;font-size:.8rem;border-radius:5px;border:1.5px solid var(--border);background:var(--surface);color:var(--text);width:100%;text-align:center}
#wg-sum-display{font-family:'JetBrains Mono',monospace;font-size:.8rem;color:var(--muted)}
#wg-sum-display.ok{color:var(--green)}
#wg-sum-display.bad{color:var(--red)}

/* HOVER TOOLTIP */
#canvas-tooltip{position:fixed;background:rgba(26,22,20,.9);color:#fff;padding:6px 10px;border-radius:6px;font-size:.72rem;pointer-events:none;display:none;z-index:50;font-family:'Inter',sans-serif;line-height:1.5}


[hidden]{display:none!important}button,input,select{font:inherit}button{touch-action:manipulation}button:focus-visible,a:focus-visible{outline:3px solid var(--gold);outline-offset:3px}p{font-size:.88rem;line-height:1.6;margin:8px 0}h3{font-family:'DM Serif Display',serif;font-size:1.25rem;font-weight:400;margin-bottom:8px}h4{font-size:.83rem;margin-bottom:8px}.slide-header>p{font-size:.83rem;color:var(--muted)}.small{font-size:.78rem}.tiny{font-size:.67rem;line-height:1.5}.muted{color:var(--muted)}.gold-text{color:var(--gold)}.green-text{color:var(--green)}.full{width:100%;margin-top:14px}.pill-tab{border:0;background:transparent}.lecture-label{font-size:.78rem;color:var(--muted)}#user-label{font-size:.72rem}#gate-secret,input[type=password],input[type=email]{width:100%;padding:9px 10px;border:1.5px solid var(--border);border-radius:6px;background:var(--surface);color:var(--text)}#gate-description{margin-bottom:16px}#gate-status{min-height:1.5em;color:var(--red)}#gate-box{width:400px;max-width:94vw}#connection{font-size:.71rem;padding:5px 20px;background:var(--gold-lt);color:var(--text);border-bottom:1px solid var(--border)}.title-questions{display:flex;gap:54px;margin-top:42px}.title-questions>div{border-top:1px solid #ffffff40;padding-top:15px;min-width:230px}.title-questions span{color:#e5c771;font-family:'JetBrains Mono',monospace;font-size:.8rem}.title-questions h3{color:#fff;line-height:1.4;margin-top:9px}.formula{font-family:'JetBrains Mono',monospace;font-size:1.04rem;line-height:1.8}.prompt{font-family:'DM Serif Display',serif;font-size:1.4rem;line-height:1.4;padding:10px 0}.chart-heading{font-size:.83rem;font-weight:600;margin-bottom:8px}.chart-heading span{float:right;font-size:.66rem;font-weight:400;color:var(--muted)}.legend{display:flex;flex-wrap:wrap;gap:12px;font-size:.68rem;margin:8px 0;color:var(--muted)}.long-key{color:var(--gold)}.short-key{color:var(--accent)}.source{font-size:.62rem;color:var(--muted);margin-top:12px;line-height:1.5}a{color:var(--gold)}.sector-row{display:grid;grid-template-columns:108px 1fr 1fr;gap:4px;align-items:center;margin:6px 0;font-size:.63rem}.sector-label{color:var(--muted);text-align:right;padding-right:6px}.sector-negative{display:flex;justify-content:flex-end;border-right:1px solid var(--border)}.sector-bar{height:17px;min-width:20px;display:flex;align-items:center;justify-content:center;font-size:.57rem;color:#fff;border-radius:2px}.sector-negative .sector-bar{background:var(--accent)}.sector-positive .sector-bar{background:var(--gold)}.exposure-row{margin:18px 0}.exposure-track{height:44px;background:var(--bg);border-radius:6px;overflow:hidden}.exposure-track>div{height:100%;min-width:115px;padding:11px 14px;color:white;font-family:'JetBrains Mono',monospace}.long-fill{background:var(--gold)}.short-fill{background:var(--accent)}.future-fill{background:var(--green)}.cash-flow{display:flex;align-items:center;gap:10px;margin:14px 0}.cash-flow>div{flex:1;background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:22px 12px;text-align:center}.cash-flow small{display:block;color:var(--muted);font-size:.7rem;margin-bottom:10px}.cash-flow strong{font-family:'JetBrains Mono',monospace;font-size:1.6rem}.cash-flow .gold-flow{background:var(--gold-lt);border-color:var(--gold)}.reveal{animation:appear .2s ease}@keyframes appear{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}canvas{width:100%;height:100%;min-height:245px;display:block;flex:1}.col-l.card,.col-r.card{display:flex;flex-direction:column;min-height:300px}.range-labels{display:flex;justify-content:space-between;font-size:.67rem;color:var(--muted)}input[type=range]{width:100%;accent-color:var(--gold);margin:18px 0 8px}.quick-weights{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.quick-weights .btn{font-size:.73rem;padding:7px 11px}.fraction-rule{display:block;border-top:2px solid var(--gold);margin:10px 0}.large-formula{font-size:1rem;text-align:center;padding:20px 0}.formula-center{align-items:center;text-align:center;padding:24px}.equation{display:flex;gap:18px;align-items:center;font-family:'JetBrains Mono',monospace;font-size:1.15rem;margin:14px 0}.fraction{display:flex;flex-direction:column;gap:10px}.fraction>span:first-child{border-bottom:2px solid var(--gold);padding-bottom:10px}.three-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:20px 0}.step-number{font-family:'JetBrains Mono',monospace;color:var(--gold);font-size:2rem;margin:12px 0}.takeaway .card{padding:24px}.closing-question{background:var(--accent);color:#fff;border-radius:10px;padding:22px;font-family:'DM Serif Display',serif;font-size:1.5rem;margin-bottom:15px}.activity-host{flex:1;min-height:0;display:flex;flex-direction:column}.activity-layout{display:grid;grid-template-columns:minmax(280px,.85fr) minmax(320px,1.15fr);gap:22px;flex:1;min-height:0}.activity-controls{overflow:auto;display:flex;flex-direction:column;gap:10px}.activity-chart{display:flex;flex-direction:column;min-height:320px}.activity-chart canvas{min-height:240px}.param-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:10px 0}.param{background:var(--bg);padding:8px;border-radius:5px}.param span{display:block;font-size:.62rem;color:var(--muted);margin-bottom:4px}.param strong{font-family:'JetBrains Mono',monospace;font-size:.84rem}.case-header{display:flex;justify-content:space-between;gap:8px;font-size:.72rem;color:var(--muted)}.activity-form{display:flex;flex-direction:column;gap:8px}.two-inputs{display:grid;grid-template-columns:1fr 1fr;gap:10px}.activity-message{font-size:.77rem;line-height:1.5;min-height:22px}.activity-message.success{color:var(--green)}.activity-message.error{color:var(--red)}.activity-message.pending{color:var(--muted)}.activity-comparison{display:flex;gap:12px;font-size:.7rem;line-height:1.5;margin:8px 0}.activity-comparison>div{flex:1;padding:9px;border-radius:6px;background:var(--bg)}.class-results{max-height:100px;overflow:auto;font-size:.7rem}.dashboard{display:grid;grid-template-columns:1.25fr 1fr;gap:20px;flex:1;min-height:0}.dashboard>.card{display:flex;flex-direction:column;min-height:0;overflow:auto}.dashboard canvas{min-height:270px}.dashboard table{font-size:.7rem}.dashboard-summary{display:flex;gap:10px;margin-bottom:8px}.dashboard-summary .stat-tile{padding:7px}.dashboard-summary .val{font-size:1.1rem}.dashboard-summary .lbl{font-size:.6rem}.status-chip{display:inline-block;padding:3px 6px;border-radius:4px;font-size:.65rem;background:var(--gold-lt);color:var(--gold)}.status-chip.done{color:var(--green);background:color-mix(in srgb,var(--green) 12%,var(--surface))}#preview-toolbar{height:auto;min-height:48px;flex-shrink:0;border-top:1px solid var(--gold);padding:7px 20px;display:flex;gap:10px;align-items:center;background:var(--gold-lt)}#preview-toolbar select{width:auto;max-width:270px;font-size:.73rem;padding:5px}#preview-badge{font-size:.72rem;font-weight:600;margin-right:auto}#preview-toolbar .btn{font-size:.7rem;padding:6px 10px}#progress-dots{gap:7px}.pdot{width:8px;height:8px;border:0;padding:0}.pdot:focus-visible{outline:2px solid var(--gold);outline-offset:3px}#settings-panel{position:fixed;right:0;top:50px;bottom:44px;width:460px;max-width:96vw;overflow:auto;padding:22px;background:var(--surface);border-left:1px solid var(--border);box-shadow:-8px 0 35px #0002;z-index:90}.panel-title{display:flex;justify-content:space-between;align-items:center}.settings-group{padding:16px 0;border-top:1px solid var(--border)}.settings-group input,.settings-group select{margin:5px 0 10px}.settings-group label{margin-top:8px}#settings-status{font-size:.75rem;min-height:20px}#roster-report{max-height:260px;overflow:auto;font-size:.69rem;margin-top:12px}.report-row{display:grid;grid-template-columns:1fr auto;gap:10px;padding:7px 0;border-bottom:1px solid var(--border)}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.empty-chart{font-size:.8rem;color:var(--muted);padding:12px}.demo-banner{background:var(--gold-lt);border:1px solid var(--gold);padding:7px 10px;border-radius:6px;font-size:.71rem;margin-bottom:10px}.activity-chart .chart-heading{margin-bottom:0}.compact-note{font-size:.72rem;line-height:1.5;color:var(--muted)}
@media(max-width:950px){.slide{padding:22px 26px 14px}.slide-body{gap:16px}.slide-header h2{font-size:1.7rem}.formula{font-size:.87rem}.equation{font-size:.95rem}.param-grid{grid-template-columns:repeat(2,1fr)}.activity-layout{gap:14px}.sector-row{grid-template-columns:88px 1fr 1fr}.lecture-label{display:none}.stat-tile .val{font-size:1.1rem}}
@media(max-width:700px){body{height:100dvh}.slide{padding:18px 18px 12px;overflow-y:auto}.slide-body{display:flex;flex-direction:column;flex:none}.col-l,.col-r{flex:none}.slide-header h2{font-size:1.5rem}.three-cards{grid-template-columns:1fr}.activity-layout,.dashboard{display:flex;flex-direction:column;flex:none}.activity-host{flex:none}.activity-controls{overflow:visible}.activity-chart canvas{height:300px;flex:none}.activity-chart{min-height:400px}canvas{height:300px;flex:none}.col-l.card,.col-r.card{min-height:330px}.title-questions{flex-direction:column;gap:20px;margin-top:25px}.title-questions>div{min-width:0}#s0{padding:30px 24px}#s0 h1{font-size:2.3rem}#s0 .meta{margin-top:22px}#topbar{gap:8px;padding:0 10px}#user-label{max-width:110px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#preview-toolbar{flex-wrap:wrap;padding:6px 10px;gap:6px}#preview-badge{width:100%}#preview-toolbar select{max-width:185px}.equation{font-size:.71rem;gap:6px}.formula-center{padding:15px 8px}.cash-flow{gap:6px}.cash-flow strong{font-size:1.3rem}.dashboard>.card{overflow:visible;min-height:250px}.param-grid{grid-template-columns:repeat(3,1fr)}}
</style></head><body>
