<div id="settings-panel" hidden style="position:fixed;top:50px;right:0;width:440px;height:calc(100vh - 50px);background:var(--surface);border-left:1px solid var(--border);z-index:200;overflow-y:auto;padding:20px;box-shadow:-4px 0 20px rgba(0,0,0,.12)">
 <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
  <div style="font-family:'DM Serif Display',serif;font-size:1.1rem;color:var(--accent)">Instructor Settings</div>
  <button id="close-settings" style="border:none;background:none;color:var(--muted);font-size:1.1rem;cursor:pointer">✕</button>
 </div>
 <div id="settings-status" role="status" style="font-size:.74rem;min-height:20px;margin-bottom:4px"></div>
 <div id="firebase-status" style="font-size:.7rem;margin-bottom:12px;color:var(--muted)">Checking Firebase…</div>

 <!-- Live Roster -->
 <div style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:8px">👥 Participants (<span id="roster-count">0</span> logged in)</div>
 <div id="roster-list" style="font-size:.74rem;color:var(--text);line-height:1.7;min-height:30px;max-height:180px;overflow-y:auto;background:var(--bg);border:1px solid var(--border);border-radius:7px;padding:8px 10px;margin-bottom:12px">
  <div style="color:var(--muted);font-style:italic">Waiting for students to log in…</div>
 </div>

 <!-- Submission stats -->
 <div style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:8px">📊 Submissions</div>
 <div style="display:flex;gap:8px;margin-bottom:10px">
  <select id="report-section" style="flex:1;padding:6px;border-radius:6px;border:1px solid var(--border);background:var(--bg);color:var(--text);font-size:.8rem">
   <option value="all">All Sections</option>
   <option value="S01">Section S01</option>
   <option value="S02">Section S02</option>
   <option value="S03">Section S03</option>
   <option value="S04">Section S04</option>
  </select>
  <button class="btn btn-gold" onclick="renderParticipation()" style="padding:6px 12px;font-size:.78rem">Refresh</button>
  <button class="btn btn-ghost" id="save-participation" style="padding:6px 10px;font-size:.78rem" title="Save to Firebase">💾</button>
 </div>
 <div id="participation-stats" style="display:flex;gap:8px;margin-bottom:12px"></div>
 <div style="font-size:.72rem;font-weight:700;color:#8B1A1A;margin-bottom:6px;text-transform:uppercase;letter-spacing:.06em">🔴 Not Connected</div>
 <div id="absent-list" style="font-size:.75rem;color:var(--text);line-height:1.8;min-height:20px">
  <div style="color:var(--muted);font-style:italic">Press Refresh</div>
 </div>
 <div style="font-size:.72rem;font-weight:700;color:var(--gold);margin-bottom:6px;margin-top:12px;text-transform:uppercase;letter-spacing:.06em">🟡 Connected — No Answers</div>
 <div id="missing-list" style="font-size:.75rem;color:var(--text);line-height:1.8;min-height:20px"></div>
 <div style="font-size:.72rem;font-weight:700;color:var(--green);margin-bottom:4px;margin-top:12px;text-transform:uppercase;letter-spacing:.06em">✅ Answered</div>
 <div style="font-size:.68rem;color:var(--muted);margin-bottom:6px">Badges: <span style="background:#1A7A4A;color:#fff;border-radius:3px;padding:1px 5px;font-size:.65rem">P1</span> E[r]/σ &nbsp;<span style="background:#1a5a8a;color:#fff;border-radius:3px;padding:1px 5px;font-size:.65rem">P2</span> Allocation &nbsp;<span style="background:#7a4a1a;color:#fff;border-radius:3px;padding:1px 5px;font-size:.65rem">SR</span> Sharpe</div>
 <div id="done-list" style="font-size:.75rem;color:var(--text);line-height:1.9;min-height:20px"></div>

 <!-- Scores by section -->
 <hr style="border:none;border-top:1px solid var(--border);margin:14px 0 10px">
 <div style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:6px">🏆 Scores &nbsp;<span style="font-weight:400;font-size:.68rem">(P1 = 3 pts · P2 = 2 pts · max 5)</span></div>
 <div style="display:flex;gap:8px;margin-bottom:8px">
  <select id="score-section" style="flex:1;padding:6px;border-radius:6px;border:1px solid var(--border);background:var(--bg);color:var(--text);font-size:.8rem">
   <option value="all">All Sections</option>
   <option value="S01">Section S01</option>
   <option value="S02">Section S02</option>
   <option value="S03">Section S03</option>
   <option value="S04">Section S04</option>
  </select>
  <button class="btn btn-gold" onclick="renderScores()" style="padding:6px 12px;font-size:.78rem">Live</button>
  <button class="btn" onclick="loadSavedScores()" style="padding:6px 12px;font-size:.78rem;background:var(--accent);color:#fff">Saved</button>
  <button class="btn" onclick="recoverAllSessions()" style="padding:6px 10px;font-size:.78rem;background:var(--gold);color:#000" title="Read all historical sessions from Firebase and reconstruct scores">🔍 Recover</button>
 </div>
 <div style="display:flex;gap:8px;margin-bottom:8px">
  <select id="score-view" style="flex:1;padding:6px;border-radius:6px;border:1px solid var(--border);background:var(--bg);color:var(--text);font-size:.8rem">
   <option value="all">All students (incl. not submitted)</option>
   <option value="submitted">Submitted only</option>
   <option value="missing">Not submitted only (0 pts)</option>
  </select>
  <button class="btn" onclick="exportScoresCSV()" style="padding:6px 10px;font-size:.78rem;background:var(--green);color:#fff" title="Download every student with points, including zeros, for Canvas">⬇ CSV for Canvas</button>
 </div>
 <div id="scores-list" style="font-size:.74rem;color:var(--text);line-height:1.75;max-height:260px;overflow-y:auto;background:var(--bg);border:1px solid var(--border);border-radius:7px;padding:8px 10px;margin-bottom:10px">
  <div style="color:var(--muted);font-style:italic">Press Live (current session) or Saved (previous sessions)</div>
 </div>

 <!-- Reset All -->
 <div style="margin-top:4px">
  <button class="btn" onclick="resetAll()" style="background:var(--red);color:#fff;width:100%;padding:8px;font-size:.8rem">💾 Save Scores &amp; Reset for Next Class</button>
 </div>
 <div style="margin-top:6px">
  <button class="btn" onclick="resetSubmissionsOnly()" style="background:var(--muted);color:#fff;width:100%;padding:8px;font-size:.8rem">🗑 Reset All Submissions (no score save)</button>
 </div>
 <div id="settings-msg" style="margin-top:10px;font-size:.74rem"></div>

 <!-- Session Control -->
 <hr style="border:none;border-top:1px solid var(--border);margin:16px 0">
 <div style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:8px">🔒 Session Control</div>
 <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px">
  <button id="session-toggle" style="padding:8px 16px;border-radius:6px;border:none;font-size:.82rem;font-weight:600;cursor:pointer;background:var(--green);color:#fff;min-width:130px">● Session Open</button>
  <span id="session-status-text" style="font-size:.73rem;color:var(--muted)">Students can log in</span>
 </div>
 <div style="font-size:.7rem;color:var(--muted);margin-bottom:10px">Toggle to close the session — students cannot log in when closed.</div>

 <!-- Per-section activation -->
 <div style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:8px">📋 Active Sections</div>
 <div style="font-size:.7rem;color:var(--muted);margin-bottom:8px">Students in inactive sections cannot log in.</div>
 <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:6px">
  <button id="sec-btn-S01" onclick="toggleSection('S01')" style="padding:7px 10px;border-radius:6px;border:none;font-size:.78rem;font-weight:600;cursor:pointer;background:var(--muted);color:#fff">S01 ○ Inactive</button>
  <button id="sec-btn-S02" onclick="toggleSection('S02')" style="padding:7px 10px;border-radius:6px;border:none;font-size:.78rem;font-weight:600;cursor:pointer;background:var(--muted);color:#fff">S02 ○ Inactive</button>
  <button id="sec-btn-S03" onclick="toggleSection('S03')" style="padding:7px 10px;border-radius:6px;border:none;font-size:.78rem;font-weight:600;cursor:pointer;background:var(--muted);color:#fff">S03 ○ Inactive</button>
  <button id="sec-btn-S04" onclick="toggleSection('S04')" style="padding:7px 10px;border-radius:6px;border:none;font-size:.78rem;font-weight:600;cursor:pointer;background:var(--muted);color:#fff">S04 ○ Inactive</button>
 </div>
 <button id="new-session" class="btn btn-ghost" style="width:100%;padding:7px;font-size:.78rem;margin-bottom:4px">Start a new session</button>
 <p class="tiny muted">Previous attendance and answers are archived, never erased.</p>

 <!-- Class Access Code -->
